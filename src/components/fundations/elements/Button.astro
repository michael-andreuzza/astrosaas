---
import type { HTMLAttributes } from "astro/types";

type ButtonVariant = "default" | "accent" | "muted" | "none";
type ButtonSize = "default" | "xs" | "sm" | "lg" | "xl" | "2xl";
type IconButtonSize =
  | "icon"
  | "icon-xs"
  | "icon-sm"
  | "icon-lg"
  | "icon-xl"
  | "icon-2xl";

export interface Props extends Omit<HTMLAttributes<"button">, "class"> {
  variant?: ButtonVariant;
  size?: ButtonSize | IconButtonSize;
  iconOnly?: boolean;
  isLink?: boolean;
  class?: string;
  href?: string;
}

const {
  variant = "default",
  size = "default",
  iconOnly = false,
  isLink = false,
  class: className,
  ...rest
}: Props = Astro.props;

const baseClass = [
  "inline-flex",
  "shrink-0",
  "cursor-pointer",
  "items-center",
  "justify-center",
  "border",
  "border-transparent",
  "bg-clip-padding",
  "text-sm",
  "font-medium",
  "whitespace-nowrap",
  "transition-all",
  "outline-none",
  "select-none",
  "focus-visible:border-ring",
  "focus-visible:ring-3",
  "focus-visible:ring-ring/50",
  "active:translate-y-px",
  "disabled:pointer-events-none",
  "disabled:opacity-50",
  "[&_svg]:pointer-events-none",
  "[&_svg]:shrink-0",
  "[&_svg:not([class*='size-'])]:size-4",
];

const variantClass: Record<ButtonVariant, string[]> = {
  default: ["bg-primary", "text-background", "hover:bg-primary/80"],
  accent: ["bg-brand", "text-background", "hover:bg-brand/90"],
  muted: [
    "border-border",
    "bg-muted",
    "text-foreground",
    "hover:bg-muted/50",
    "hover:text-foreground",
  ],
  none: [],
};

const sizes: Record<ButtonSize, string[]> = {
  default: ["h-10", "gap-2", "rounded-lg", "px-4", "text-sm"],
  xs: [
    "h-8",
    "gap-2",
    "rounded-md",
    "px-4",
    "text-xs",
    "[&_svg:not([class*='size-'])]:size-4",
  ],
  sm: [
    "h-10",
    "gap-2",
    "rounded-lg",
    "px-4",
    "text-sm",
    "[&_svg:not([class*='size-'])]:size-4",
  ],
  lg: [
    "h-12",
    "gap-2",
    "rounded-lg",
    "px-4",
    "text-base",
    "[&_svg:not([class*='size-'])]:size-4",
  ],
  xl: [
    "h-16",
    "gap-2",
    "rounded-xl",
    "px-4",
    "text-lg",
    "[&_svg:not([class*='size-'])]:size-5",
  ],
  "2xl": [
    "h-20",
    "gap-2",
    "rounded-xl",
    "px-5",
    "text-lg",
    "[&_svg:not([class*='size-'])]:size-5",
  ],
};

const iconSizes: Record<IconButtonSize, string[]> = {
  icon: ["size-10", "rounded-lg"],
  "icon-xs": ["size-8", "rounded-md", "[&_svg:not([class*='size-'])]:size-4"],
  "icon-sm": ["size-10", "rounded-lg"],
  "icon-lg": ["size-12", "rounded-lg"],
  "icon-xl": ["size-16", "rounded-xl", "[&_svg:not([class*='size-'])]:size-5"],
  "icon-2xl": ["size-20", "rounded-xl", "[&_svg:not([class*='size-'])]:size-5"],
};

const sizeClass = iconOnly
  ? (iconSizes[size as IconButtonSize] ?? iconSizes.icon)
  : (sizes[size as ButtonSize] ?? sizes.default);
const additionalClasses = className ? className.split(" ") : [];
---

{
  isLink ? (
    <a
      href={rest.href}
      class:list={[
        ...baseClass,
        ...(variantClass[variant] || []),
        ...sizeClass,
        ...additionalClasses,
      ]}
      {...rest}
    >
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </a>
  ) : (
    <button
      class:list={[
        ...baseClass,
        ...(variantClass[variant] || []),
        ...sizeClass,
        ...additionalClasses,
      ]}
      {...rest}
    >
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </button>
  )
}
