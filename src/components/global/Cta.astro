---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const ads = [
  {
    title: "Lexington Themes",
    event: "lexingtonAdd",
    href: "https://lexingtonthemes.com/",
    imgSrc: "https://lexingtonthemes.com/OpenGraph/twitter.png",
    description:
      "Launch faster with premium Astro V7 & Tailwind CSS, Sanity CMS and EmDash CMS themes",
  },
  {
    title: "Kobbe",
    event: "kobbeAdd",
    href: "https://kobbe.io/",
    imgSrc: "https://kobbe.io/images/opengraph/facebook.png",
    description:
      "Privacy-first web analytics with traffic and revenue in one place.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        ads.map((ad) => (
          <div class="group relative  ring-4 ring-base-50 border border-base-200 cursor-pointer   rounded-2xl overflow-hidden">
            <a href={ad.href} class="absolute inset-0" />
            <div class="flex flex-col items-start justify-between h-full ">
              <Image
                alt={ad.description}
                width={400}
                height={240}
                class="block w-full h-full  cursor-pointer overflow-hidden  object-cover  aspect-16/8 object-left"
                src={ad.imgSrc}
                style={{ color: "transparent" }}
              />
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
