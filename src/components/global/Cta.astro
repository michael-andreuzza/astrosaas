---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const ads = [
  {
    title: "Lexington Themes",
    event: "lexingtonAdd",
    href: "https://lexingtonthemes.com/",
    imgSrc: "https://lexingtonthemes.com/OpenGraph/twitter.png",
    description:
      "Launch faster with premium Astro V7 & Tailwind CSS, Sanity CMS and EmDash CMS themes.",
  },
  {
    title: "Kobbe",
    event: "kobbeAdd",
    href: "https://kobbe.io/",
    imgSrc: "https://kobbe.io/images/opengraph/facebook.png",
    description:
      "Privacy-first web analytics with traffic and revenue in one place.",
  },
];
---

<section>
  <Wrapper variant="default" class="py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        ads.map((ad) => (
          <div class="group relative border border-border cursor-pointer  rounded-xl bg-background overflow-hidden">
            <a href={ad.href} class="absolute inset-0" />
            <div class="flex flex-col items-start justify-between h-full ">
              <Image
                alt={ad.description}
                width={400}
                height={240}
                class="block w-full h-full  cursor-pointer overflow-hidden  object-cover  aspect-16/8 object-top"
                src={ad.imgSrc}
                style={{ color: "transparent" }}
              />
              <div class="p-8  border-b border-border order-first h-full flex flex-col justify-between gap-8">
                <div>
                  <Text
                    tag="h3"
                    variant="textLG"
                    class="font-medium text-foreground"
                  >
                    {ad.title}
                  </Text>
                  <Text
                    tag="p"
                    variant="textBase"
                    class="text-muted-foreground mt-1"
                  >
                    {ad.description}
                  </Text>
                </div>
                <Button
                  isLink
                  size="sm"
                  variant="default"
                  href={ad.href}
                  class="w-fit"
                >
                  Visit {ad.title}
                </Button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
