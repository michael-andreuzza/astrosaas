---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const sections = [
  {
    title: "All pages",
    links: [
      { name: "Home", href: "/" },
      { name: "Terms", href: "/terms" },
      { name: "Sign up", href: "/signup" },
      { name: "Sign in", href: "/login" },
    ],
  },
  {
    title: "Resources",
    links: [
      {
        name: "GitHub repo",
        href: "https://github.com/michael-andreuzza/astrosaas",
      },
    ],
  },
  {
    title: "More themes",
    links: [
      {
        name: "Lexington Themes",
        href: "https://lexingtonthemes.com/",
      },
      {
        name: "Kobbe",
        href: "https://kobbe.io/",
      },
      {
        name: "NonCommon",
        href: "https://noncommon.site/",
      },
    ],
  },
  {
    title: "Socials",
    links: [
      {
        name: "@lexingtonthemes",
        href: "https://x.com/lexingtonthemes",
      },
      {
        name: "@Mike_Andreuzza",
        href: "https://x.com/Mike_Andreuzza",
      },
    ],
  },
];
const currentYear = new Date().getFullYear();
---

<footer>
  <Wrapper variant="default" class="py-12">
    <nav
      class="grid grid-cols-2 gap-8 text-sm md:grid-cols-4 lg:grid-cols-5"
      aria-label="Footer"
    >
      <a href="/" aria-label="Homepage">
        <Logo class="text-foreground h-12 w-fit shrink-0" />
      </a>
      {
        sections.map(({ title, links }) => (
          <div class="space-y-3">
            <Text
              tag="p"
              variant="textXS"
              class="text-foreground font-semibold uppercase"
            >
              {title}
            </Text>
            <ul role="list" class="space-y-1">
              {links.map(({ name, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-muted-foreground hover:text-foreground text-xs font-medium transition-colors"
                  >
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div class="border-t pt-6 border-border mt-8">
      <p class="text-xs text-muted-foreground lg:col-span-2">
        © {currentYear} Lexington Themes. All rights reserved. The biggest Astro collection
        with premium themes. Clean code. Modern design. Easy to customize. Production-ready.
        Trusted by 8,000+ freelancers, startups, and agencies — Awarded by Astro.
        A side project by <a
          class="text-sm text-foreground hover:text-foreground underline"
          href="https://michaelandreuzza.com/">Michael Andreuzza</a
        > This website was built with Astro &amp; Tailwind. Crafted in Åland Islands,
        Finland.
      </p>
    </div>
  </Wrapper>
</footer>
