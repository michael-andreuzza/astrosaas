---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ChevronDown from "@/components/fundations/icons/ChevronDown.astro";

const faqs = [
  {
    id: "what-is-crm",
    question: "What is a CRM system?",
    answer:
      "A CRM (Customer Relationship Management) system is a software platform designed to help businesses manage and analyze customer interactions and data throughout the customer lifecycle.",
  },
  {
    id: "getting-started",
    question: "How do I get started with your CRM?",
    answer:
      "Simply sign up for an account, import your customer data, and start using our intuitive dashboard to manage your customer relationships effectively.",
  },
  {
    id: "features",
    question: "What features does your CRM offer?",
    answer:
      "We provide contact management, sales pipeline tracking, email integration, reporting and analytics, task automation, and customer communication tools.",
  },
  {
    id: "trial",
    question: "Is there a free trial available?",
    answer:
      "Yes, we offer a 14-day free trial for new users to explore all our CRM features and see how it can benefit your business.",
  },
  {
    id: "integrations",
    question: "Can I integrate your CRM with other tools?",
    answer:
      "Absolutely. Our CRM supports integrations with popular business tools like Gmail, Outlook, Slack, Zapier, and many other marketing and sales platforms.",
  },
  {
    id: "support",
    question: "What kind of support do you provide?",
    answer:
      "We offer 24/7 customer support via chat, email, and phone, plus a comprehensive knowledge base, video tutorials, and dedicated account managers for enterprise clients.",
  },
  {
    id: "security",
    question: "Is my customer data secure?",
    answer:
      "Yes, we use industry-standard encryption, secure data centers, and comply with GDPR and other privacy regulations to protect your customer data.",
  },
  {
    id: "plans",
    question: "Can I upgrade or downgrade my plan anytime?",
    answer:
      "Yes, you can change your plan at any time through your account settings. Upgrades take effect immediately, while downgrades apply at the next billing cycle.",
  },
  {
    id: "training",
    question: "Do you offer training for your CRM?",
    answer:
      "We provide extensive training resources including video tutorials, webinars, live training sessions, and a community forum where users can share tips and best practices.",
  },
  {
    id: "cancel",
    question: "What if I need to cancel my subscription?",
    answer:
      "You can cancel anytime from your account dashboard. We'll provide data export options and process any refunds according to our policy.",
  },
];
---

<section id="faq" aria-labelledby="faq-heading" class="pt-8">
  <Wrapper variant="default" class="py-20">
    <div class="mx-auto max-w-2xl">
      <div class="text-balance">
        <Text
          id="faq-heading"
          tag="h2"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          FAQ
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-1.5 font-normal"
        >
          Quick answers about plans, setup, integrations, and support.
        </Text>
      </div>

      <div
        class="border-border mt-10 w-full border-y"
        aria-labelledby="faq-heading"
      >
        {
          faqs.map((faq) => (
            <details class="group border-border border-b last:border-b-0">
              <summary class="text-foreground hover:text-muted-foreground flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-semibold transition-colors duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] outline-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <ChevronDown class="text-muted-foreground transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-open:rotate-180" />
              </summary>
              <p class="text-muted-foreground pb-4 text-sm leading-relaxed text-pretty">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>

    
    </div>
  </Wrapper>
</section>
