---
// Assets
import { Image } from "astro:assets";
import DashboardLight from "@/images/dashboardLight.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="overflow-hidden">
  <Wrapper class="pt-20 lg:pt-28">
    <div class="mx-auto max-w-2xl text-center">
      <div class="text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          A starter template built with Astro and Tailwind CSS for your next
          project
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-1.5 font-normal"
        >
          Feature sections, a pricing table, testimonial, CTA, and full forms.
        </Text>
      </div>
      <div class="mx-auto mt-4 flex w-fit flex-wrap justify-center gap-2">
        <Button
          variant="default"
          size="xs"
          isLink
          href="https://lexingtonthemes.com"
        >
          More themes</Button
        >
        <Button
          variant="muted"
          size="xs"
          isLink
          href="https://github.com/michael-andreuzza/astrosaas">GitHub</Button
        >
      </div>
    </div>

    <div class="mt-12">
      <Image
        alt="Dashboard"
        width={900}
        height={700}
        src={DashboardLight}
        class="relative w-full rounded-xl object-cover"
      />
    </div>
  </Wrapper>
</section>
