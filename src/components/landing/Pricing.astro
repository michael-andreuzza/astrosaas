---
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import PricingFeatureMark from "@/components/fundations/icons/PricingFeatureMark.astro";

const yearlyBillingSavingsLabel = "2 months free";

const pricingTiers = [
  {
    name: "Core",
    subtitle: "For small teams and founders",
    description: "Centralize leads and keep every follow-up on track.",
    monthly: 29,
    annual: 19,
    features: [
      "Up to 1,500 contacts across 2 pipelines",
      "Kanban board with stage automations",
      "Gmail/Outlook and calendar sync",
      "Tasks, reminders, and SLA timers",
      "Standard reports and exports",
      "Email and community support",
    ],
    cta: "Start Core",
    isPopular: false,
  },
  {
    name: "Momentum",
    subtitle: "For scaling revenue teams",
    description: "Automation, shared inbox, and forecasting for growing teams.",
    monthly: 49,
    annual: 39,
    features: [
      "Up to 15,000 contacts and 5 pipelines",
      "Automation workflows and sequences",
      "Shared inbox with collision detection",
      "Custom fields, views, and dashboards",
      "Forecasting and revenue analytics",
      "API, webhooks, and priority support",
    ],
    cta: "Upgrade to Momentum",
    isPopular: true,
  },
  {
    name: "Growth",
    subtitle: "For established sales orgs",
    description:
      "Enterprise controls and dedicated support for complex sales orgs.",
    monthly: 99,
    annual: 79,
    features: [
      "Unlimited contacts, pipelines, and seats",
      "Advanced permissions and SSO",
      "Two-way data syncs and enrichment",
      "Playbooks with approval workflows",
      "Dedicated success manager",
      "Exports, audit logs, and SLA-backed support",
    ],
    cta: "Talk to sales",
    isPopular: false,
  },
];

function formatPrice(amount: number) {
  return `$${amount.toFixed(amount % 1 === 0 ? 0 : 2)}`;
}
---

<section id="pricing" aria-labelledby="pricing-heading">
  <Wrapper variant="default" class="py-20">
    <div class="mx-auto max-w-2xl text-center">
      <div class="text-balance">
        <Text
          id="pricing-heading"
          tag="h2"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          CRM pricing for every stage
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-1.5 font-normal"
        >
          From founder-led sales to multi-team RevOps, pick the plan that keeps
          deals moving.
        </Text>
      </div>

      <div
        id="billing-period-tabs"
        class="mt-10 inline-flex items-center gap-2.5"
        data-period="monthly"
      >
        <span
          id="billing-label-monthly"
          class="text-sm font-medium text-foreground"
        >
          Monthly
        </span>
        <button
          id="billing-period-switch"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="Monthly billing. Switch to yearly."
          class="focus-visible:ring-ring/50 relative inline-flex h-4 w-7 shrink-0 border-0 bg-transparent p-0 outline-none focus-visible:ring-3"
        >
          <span
            id="billing-track"
            aria-hidden="true"
            class="absolute inset-x-0 top-1/2 h-3 -translate-y-1/2 rounded-full bg-foreground/15 transition-colors"
          >
          </span>
          <span
            id="billing-thumb"
            aria-hidden="true"
            class="bg-foreground absolute top-1/2 size-3.5 -translate-y-1/2 translate-x-0 rounded-full transition-transform duration-200 ease-out"
          >
          </span>
        </button>
        <span
          id="billing-label-yearly"
          class="text-sm font-medium text-muted-foreground"
        >
          Yearly
        </span>
        <span class="text-muted-foreground text-sm font-medium">
          {yearlyBillingSavingsLabel}
        </span>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-3">
      {
        pricingTiers.map((tier, index) => (
          <article class="bg-background text-foreground  relative flex w-full flex-col overflow-hidden rounded-lg border border-border">
            <div class="flex flex-1 flex-col p-4 lg:p-8">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-base font-medium">{tier.name}</h3>
                  <p class="text-muted-foreground text-sm font-medium">
                    {tier.subtitle}
                  </p>
                </div>
                {tier.isPopular && (
                  <span class="bg-muted text-foreground shrink-0 rounded-md px-2.5 py-1 text-xs font-medium">
                    Popular
                  </span>
                )}
              </div>

              <p class="text-muted-foreground mt-4 text-sm font-medium text-balance">
                {tier.description}
              </p>

              <div class="mt-8">
                <div
                  class="pricing-price-display inline-flex items-baseline gap-1.5 tabular-nums leading-[1.45]"
                  data-monthly={tier.monthly}
                  data-annual={tier.annual}
                  data-index={index}
                >
                  <span
                    class="price-compare text-muted-foreground decoration-muted-foreground hidden text-xl font-medium line-through opacity-40"
                    aria-hidden="true"
                  />
                  <span class="text-foreground font-display overflow-hidden py-0.5 pr-2 text-4xl font-normal tracking-tight italic sm:text-5xl">
                    <span class="price-amount">
                      {formatPrice(tier.monthly)}
                    </span>
                  </span>
                  <span class="text-muted-foreground ml-0.5 text-sm font-medium">
                    /mo
                  </span>
                </div>
                <p
                  class="billing-period-label text-muted-foreground mt-1 text-sm font-medium"
                  data-monthly-label="Billed monthly"
                  data-yearly-label="Per month, billed yearly"
                >
                  Billed monthly
                </p>
              </div>

              <Button size="lg" class="mt-4 w-full">
                {tier.cta}
              </Button>

              <ul
                class="text-foreground mt-8 flex list-none flex-col items-start gap-y-1.5 font-medium"
                role="list"
              >
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2">
                    <PricingFeatureMark />
                    <p class="text-sm tracking-tight">{feature}</p>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabs = document.getElementById("billing-period-tabs");
    const switchBtn = document.getElementById("billing-period-switch");
    const track = document.getElementById("billing-track");
    const thumb = document.getElementById("billing-thumb");
    const labelMonthly = document.getElementById("billing-label-monthly");
    const labelYearly = document.getElementById("billing-label-yearly");

    if (
      !tabs ||
      !switchBtn ||
      !track ||
      !thumb ||
      !labelMonthly ||
      !labelYearly
    ) {
      return;
    }

    const formatPrice = (amount: number) =>
      `$${amount.toFixed(amount % 1 === 0 ? 0 : 2)}`;

    const setPeriod = (isYearly: boolean) => {
      tabs.dataset.period = isYearly ? "yearly" : "monthly";
      switchBtn.setAttribute("aria-checked", String(isYearly));
      switchBtn.setAttribute(
        "aria-label",
        `${isYearly ? "Yearly" : "Monthly"} billing. Switch to ${isYearly ? "monthly" : "yearly"}.`,
      );

      labelMonthly.classList.toggle("text-foreground", !isYearly);
      labelMonthly.classList.toggle("text-muted-foreground", isYearly);
      labelYearly.classList.toggle("text-foreground", isYearly);
      labelYearly.classList.toggle("text-muted-foreground", !isYearly);

      track.classList.toggle("bg-brand", isYearly);
      track.classList.toggle("bg-foreground/15", !isYearly);
      thumb.classList.toggle("translate-x-3.5", isYearly);
      thumb.classList.toggle("translate-x-0", !isYearly);

      document.querySelectorAll(".pricing-price-display").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;

        const monthly = Number(el.dataset.monthly);
        const annual = Number(el.dataset.annual);
        const amountEl = el.querySelector(".price-amount");
        const compareEl = el.querySelector(".price-compare");

        if (!(amountEl instanceof HTMLElement)) return;

        const displayAmount = isYearly ? annual : monthly;
        amountEl.textContent = formatPrice(displayAmount);

        if (compareEl instanceof HTMLElement) {
          const showCompare = isYearly && monthly !== annual;
          compareEl.classList.toggle("hidden", !showCompare);
          compareEl.textContent = showCompare ? formatPrice(monthly) : "";
        }
      });

      document.querySelectorAll(".billing-period-label").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        el.textContent = isYearly
          ? el.dataset.yearlyLabel
          : el.dataset.monthlyLabel;
      });
    };

    switchBtn.addEventListener("click", () => {
      setPeriod(tabs.dataset.period !== "yearly");
    });
  });
</script>
