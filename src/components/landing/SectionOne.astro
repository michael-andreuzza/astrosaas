---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const features = [
  "Contact Management",
  "Lead Tracking",
  "Customer Segmentation",
  "Email Campaigns",
  "Sales Pipeline",
  "Task Automation",
  "Reporting Dashboards",
  "Mobile Access",
  "Data Import/Export",
  "User Permissions",
  "Integration APIs",
  "Customer Support Ticketing",
];

const featureItems = [
  {
    title: "Contact Management",
    description:
      "Organize every contact, company, and note in one searchable workspace.",
  },
  {
    title: "Lead Tracking",
    description:
      "Follow leads from first touch to closed deal with a clear activity history.",
  },
  {
    title: "Sales Forecasting",
    description:
      "Project revenue by stage and close date so planning stays grounded.",
  },
  {
    title: "Automated Workflows",
    description:
      "Trigger tasks, emails, and handoffs when records move or conditions match.",
  },
  {
    title: "Visual pipeline",
    description:
      "Drag deals across stages on a kanban board the whole team can read.",
  },
  {
    title: "Email & calendar sync",
    description:
      "Log conversations automatically by connecting Gmail or Outlook.",
  },
  {
    title: "Reporting dashboards",
    description:
      "Track conversion, pipeline health, and rep activity without spreadsheets.",
  },
  {
    title: "Integrations & API",
    description:
      "Connect your stack with webhooks, Zapier, and a REST API for custom flows.",
  },
];
---

<section id="features" class="pt-8">
  <Wrapper variant="default" class="py-20">
    <div class="mx-auto max-w-xl text-center">
      <div class="text-balance">
        <Text
          tag="h2"
          variant="displayMD"
          class="text-foreground font-display tracking-tight"
        >
          Empowering businesses with intelligent CRM solutions
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="text-muted-foreground mt-1.5 font-normal"
        >
          The most efficient way to manage customer relationships and boost
          sales performance.
        </Text>
      </div>
    </div>

    <div class="relative mx-auto overflow-hidden overflow-x-hidden py-12">
      <div class="grid w-full justify-between">
        <div
          class="from-muted absolute inset-0 left-0 z-10 w-44 bg-linear-to-r via-transparent"
        >
        </div>
        <div
          class="from-muted absolute inset-0 left-0 z-10 ml-auto w-44 bg-linear-to-l via-transparent"
        >
        </div>
      </div>
      <div class="relative flex items-center gap-2 whitespace-nowrap">
        {
          features.map((feature) => (
            <span class="text-foreground/80 bg-background border border-border relative inline-flex items-center rounded-lg px-4 py-1.5 text-sm font-medium">
              {feature}
            </span>
          ))
        }
      </div>
    </div>

    <div
      class="mx-auto mt-12 grid max-w-6xl gap-x-6 gap-y-8 text-balance sm:grid-cols-2 lg:grid-cols-4 lg:text-center"
    >
      {
        featureItems.map((item) => (
          <div class="space-y-1">
            <h3 class="text-foreground text-base font-medium">{item.title}</h3>
            <p class="text-muted-foreground text-sm text-pretty">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
