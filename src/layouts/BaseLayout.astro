---
// Fundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Section
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
// Hides the  navigation, or footer on selected screens by passing props:
// <BaseLayout hideNavigation={true} hideFooter={true}>
const { hideNavigation = false, hideFooter = false } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <script is:inline>
      (function () {
        if (window.top !== window.self) return;
        var h = location.hostname;
        if (h === "localhost" || h === "127.0.0.1") return;
        location.replace("https://lexingtonthemes.com/viewports/astrosaas");
      })();
    </script>
    <BaseHead />
  </head>
  <body class="flex flex-col bg-muted min-h-dvh">
    {!hideNavigation && <Navigation />}
    <main class="grow"><slot /></main>
    {!hideFooter && <Footer />}

  </body>
</html>
