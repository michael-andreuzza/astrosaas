---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="default" class="py-20">
      <div class="max-w-sm mx-auto">
        <div class="text-balance">
          <Text
            tag="h1"
            variant="displaySM"
            class="text-foreground font-display tracking-tight"
          >
            Join our community
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="text-muted-foreground mt-1.5 font-normal"
          >
            Sign up to join our community and start building your brand.
          </Text>
        </div>
        <form action="#" method="POST" class="mx-auto mt-12">
          <div class="flex flex-col gap-y-6">
            <div>
              <label class="text-sm text-muted-foreground font-medium">
                First name
              </label>
              <div class="mt-2.5">
                <input
                  type="text"
                  name="first-name"
                  id="first-name"
                  autocomplete="given-name"
                  required
                  class="block w-full h-10 px-4 py-2 text-sm text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-input focus:bg-transparent focus:outline-none focus:ring-ring focus:ring-offset-2 focus:ring-2 sm:text-sm"
                />
              </div>
            </div>
            <div>
              <label class="text-sm text-muted-foreground font-medium"> Email </label>
              <div class="mt-2.5">
                <input
                  type="email"
                  name="email"
                  id="email"
                  autocomplete="email"
                  required
                  class="block w-full h-10 px-4 py-2 text-sm text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-input focus:bg-transparent focus:outline-none focus:ring-ring focus:ring-offset-2 focus:ring-2 sm:text-sm"
                />
              </div>
            </div>
          </div>
          <div class="flex items-center mt-4 gap-3">
            <input
              id="agreement"
              name="agreement"
              type="checkbox"
              class="size-4 rounded border-input text-foreground focus:ring-ring shadow"
            />
            <label class="undefined block text-sm text-muted-foreground">
              You agree to our
              <a class="text-foreground hover:text-muted-foreground" href="#_">
                Terms of service
              </a>
              and
              <a class="t text-foreground hover:text-muted-foreground" href="#_">
                Privacy Policy
              </a>
            </label>
          </div>
          <Button variant="default" class="mt-8 w-full">
            Sign up
          </Button>
          <div class="flex items-center mt-4">
            <Text tag="p" variant="textSM" class="text-muted-foreground">
              Don't have an account? Already have an account?
              <a class="text-foreground hover:text-muted-foreground" href="/login">
                Sign in
              </a>
            </Text>
          </div>
        </form>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
